# ─────────────────────────────────────────────────────────────
#  운영 배포 전 체크리스트는 GET /api/health 로 확인할 수 있습니다.
# ─────────────────────────────────────────────────────────────

# ── 공개 배포 (docker compose) ──────────────────────────────
# DB 비밀번호. 기본값이 없으므로 반드시 채워야 컨테이너가 뜹니다.
POSTGRES_PASSWORD=

# 도메인을 직접 쓸 때만 필요합니다 (docker compose --profile domain).
# Caddy 가 이 이름으로 HTTPS 인증서를 받습니다.
# 도메인이 없으면 서버 공인 IP 로 만든 이름도 됩니다.
#   IP 가 203.0.113.10 이면 → DOMAIN=203-0-113-10.sslip.io
#
# Cloudflare Tunnel 로 여는 경우에는 비워 둡니다. 터널이 HTTPS 를 처리합니다.
#   docker compose up -d
#   cloudflared tunnel --url http://localhost:3000
#
# 어느 쪽이든 HTTPS 는 필수입니다. 세션 쿠키가 운영 모드에서 secure 로 발급되어
# 평문 HTTP 에서는 브라우저가 저장하지 않고, 그러면 로그인이 되지 않습니다.
DOMAIN=

# ── 데이터베이스 (PostgreSQL) ─── 필수 ─────────────────────
# 없으면 DB 없이 동작하지만 로그인·이력·결과가 브라우저에만 남습니다.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dku_opic?schema=public"

# ── 이메일 인증 (SMTP) ─── 운영 필수 ───────────────────────
# 개발 모드: 없으면 인증 코드가 서버 로그와 화면에 표시됩니다.
# 운영 모드: 없으면 코드를 아예 발급하지 않아 로그인이 막힙니다.
#
# 설정 후 확인:  npm run check:smtp -- 본인주소@dankook.ac.kr
# 포트와 SECURE 는 짝입니다. 587 -> false(STARTTLS), 465 -> true
# SMTP_FROM 은 인증한 계정이 보낼 수 있는 주소여야 합니다 (아니면 550 거부/스팸행)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="단국대 OPIc 트레이너 <no-reply@dankook.ac.kr>"

# ── 시연 계정 ─── 임시 ─────────────────────────────────────
# SMTP 가 열리기 전에 시연·파일럿을 돌리기 위한 고정 코드 계정입니다.
# 여기 적힌 주소만 메일 없이 고정 코드로 로그인하고, 나머지는 평소대로 메일 인증입니다.
#
#   형식: 이메일:코드 (쉼표로 구분, 코드 6자 이상)
#   DEMO_ACCOUNTS="dankuk1@dankook.ac.kr:481902,dankuk2@dankook.ac.kr:735164"
#
# 코드는 바뀌지 않으므로 새어 나가면 그대로 로그인 통로가 됩니다.
# SMTP 를 붙인 뒤에는 비워 두세요. /api/health 가 켜져 있는 동안 계속 알려 줍니다.
DEMO_ACCOUNTS=

# ── 운영 점검 ──────────────────────────────────────────────
# GET /api/health 의 상세 내역(무엇이 폴백인지)을 볼 때 쓰는 토큰.
#   curl -H "x-health-token: ..." https://.../api/health
# 비워 두면 로그인한 사용자만 상세를 볼 수 있습니다.
HEALTH_TOKEN=

# ── 채점 LLM — Claude Sonnet 5 ─────────────────────────────
# 없으면 지표 기반 폴백 채점만 동작합니다.
ANTHROPIC_API_KEY=

# ── STT ────────────────────────────────────────────────────
# STT 가 서버 크기를 정합니다. 다른 조각(Next.js + Postgres)은 다 합쳐도
# 1GB 를 넘지 않지만, whisper 모델은 메모리에 통째로 올라갑니다.
#
# faster-whisper (기본) : 자체 호스팅, 종량 비용 0, 메모리가 필요
# muse                  : Meta Model API, 서버 메모리 불필요, 분당 과금
# mock                  : 개발용. 답변이 인식되지 않습니다
STT_PROVIDER=faster-whisper
STT_URL=http://localhost:8000

# 자체 호스팅일 때 모델 크기. 클수록 정확하고 메모리를 더 씁니다.
# CPU 로 돌리면 큰 모델은 느립니다 (답변 1분에 수십 초).
#   large-v3          가장 정확 / 가장 무거움
#   distil-large-v3   기본값. 정확도 대비 가벼움
#   small             2GB 서버에서도 도는 선. 시연에는 충분
#   base              가장 가벼움. 오인식이 늘어 채점 품질이 떨어집니다
# 실제 사용량은 docker stats 로 확인하세요.
WHISPER_MODEL=distil-large-v3
# WHISPER_DEVICE=auto      # GPU 가 있으면 cuda

# STT_PROVIDER=muse 일 때만 필요
MUSE_API_KEY=
# MUSE_API_URL=https://api.meta.ai/v1
# MUSE_MODEL=muse-voice-transcribe-1.0

# ── TTS (오프라인 배치) ────────────────────────────────────
# 런타임에는 쓰이지 않습니다. services/tts/generate.py 실행 시에만 참조합니다.
# KOKORO_DIR=services/tts/models
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=0.95
