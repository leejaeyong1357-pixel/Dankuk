# ── 데이터베이스 (PostgreSQL) ─────────────────────────────
# 없으면 DB 없이 동작합니다. 이 경우 이력·결과가 브라우저에만 남습니다.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dku_opic?schema=public"

# ── 채점 LLM — Claude Sonnet 5 ────────────────────────────
# 없으면 지표 기반 폴백 채점으로 동작합니다.
ANTHROPIC_API_KEY=

# ── STT — faster-whisper 마이크로서비스 (services/stt) ────
# 없으면 목업 전사로 폴백합니다.
STT_URL=http://localhost:8000
