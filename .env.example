# ─────────────────────────────────────────────────────────────
#  운영 배포 전 체크리스트는 GET /api/health 로 확인할 수 있습니다.
# ─────────────────────────────────────────────────────────────

# ── 데이터베이스 (PostgreSQL) ─── 필수 ─────────────────────
# 없으면 DB 없이 동작하지만 로그인·이력·결과가 브라우저에만 남습니다.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dku_opic?schema=public"

# ── 이메일 인증 (SMTP) ─── 운영 필수 ───────────────────────
# 없으면 인증 코드가 서버 로그에만 남고 화면에 노출됩니다. 개발 전용입니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="단국대 OPIc 트레이너 <no-reply@dankook.ac.kr>"

# ── 채점 LLM — Claude Sonnet 5 ─────────────────────────────
# 없으면 지표 기반 폴백 채점만 동작합니다.
ANTHROPIC_API_KEY=

# ── STT ────────────────────────────────────────────────────
# faster-whisper (기본) : 자체 호스팅, GPU 필요, 종량 비용 0
# muse                  : Meta Model API, GPU 불필요, 분당 과금
# mock                  : 개발용
STT_PROVIDER=faster-whisper
STT_URL=http://localhost:8000

# STT_PROVIDER=muse 일 때만 필요
MUSE_API_KEY=
# MUSE_API_URL=https://api.meta.ai/v1
# MUSE_MODEL=muse-voice-transcribe-1.0

# ── TTS (오프라인 배치) ────────────────────────────────────
# 런타임에는 쓰이지 않습니다. services/tts/generate.py 실행 시에만 참조합니다.
# KOKORO_DIR=services/tts/models
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=0.95
