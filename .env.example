# ─────────────────────────────────────────────────────────────
#  운영 배포 전 체크리스트는 GET /api/health 로 확인할 수 있습니다.
# ─────────────────────────────────────────────────────────────

# ── 데이터베이스 (PostgreSQL) ─── 필수 ─────────────────────
# 없으면 DB 없이 동작하지만 로그인·이력·결과가 브라우저에만 남습니다.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dku_opic?schema=public"

# ── 이메일 인증 (SMTP) ─── 운영 필수 ───────────────────────
# 개발 모드: 없으면 인증 코드가 서버 로그와 화면에 표시됩니다.
# 운영 모드: 없으면 코드를 아예 발급하지 않아 로그인이 막힙니다.
#
# 설정 후 확인:  npm run check:smtp -- 본인주소@dankook.ac.kr
# 포트와 SECURE 는 짝입니다. 587 -> false(STARTTLS), 465 -> true
# SMTP_FROM 은 인증한 계정이 보낼 수 있는 주소여야 합니다 (아니면 550 거부/스팸행)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="단국대 OPIc 트레이너 <no-reply@dankook.ac.kr>"

# ── 시연 계정 ─── 임시 ─────────────────────────────────────
# SMTP 가 열리기 전에 시연·파일럿을 돌리기 위한 고정 코드 계정입니다.
# 여기 적힌 주소만 메일 없이 고정 코드로 로그인하고, 나머지는 평소대로 메일 인증입니다.
#
#   형식: 이메일:코드 (쉼표로 구분, @dankook.ac.kr, 코드 6자 이상)
#   DEMO_ACCOUNTS="dankuk1@dankook.ac.kr:481902,dankuk2@dankook.ac.kr:735164"
#
# 코드는 바뀌지 않으므로 새어 나가면 그대로 로그인 통로가 됩니다.
# SMTP 를 붙인 뒤에는 비워 두세요. /api/health 가 켜져 있는 동안 계속 알려 줍니다.
DEMO_ACCOUNTS=

# ── 운영 점검 ──────────────────────────────────────────────
# GET /api/health 의 상세 내역(무엇이 폴백인지)을 볼 때 쓰는 토큰.
#   curl -H "x-health-token: ..." https://.../api/health
# 비워 두면 로그인한 사용자만 상세를 볼 수 있습니다.
HEALTH_TOKEN=

# ── 채점 LLM — Claude Sonnet 5 ─────────────────────────────
# 없으면 지표 기반 폴백 채점만 동작합니다.
ANTHROPIC_API_KEY=

# ── STT ────────────────────────────────────────────────────
# faster-whisper (기본) : 자체 호스팅, GPU 필요, 종량 비용 0
# muse                  : Meta Model API, GPU 불필요, 분당 과금
# mock                  : 개발용
STT_PROVIDER=faster-whisper
STT_URL=http://localhost:8000

# STT_PROVIDER=muse 일 때만 필요
MUSE_API_KEY=
# MUSE_API_URL=https://api.meta.ai/v1
# MUSE_MODEL=muse-voice-transcribe-1.0

# ── TTS (오프라인 배치) ────────────────────────────────────
# 런타임에는 쓰이지 않습니다. services/tts/generate.py 실행 시에만 참조합니다.
# KOKORO_DIR=services/tts/models
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=0.95
